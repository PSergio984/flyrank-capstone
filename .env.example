DATABASE_URL=postgres://postgres:dev@localhost:5432/tasks
PORT=3000

# Supabase Auth (the Identity Provider) — from Project Settings -> API.
# The anon key is safe to share with clients; .env is gitignored so it never ships.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_anon_key

# LLM provider — 3 vars are the only difference between local and hosted.
# OpenRouter: https://openrouter.ai/api/v1 + openrouter/free (flip two Privacy switches before 404)
# Ollama:     http://localhost:11434/v1   + ollama          + gemma3:1b
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openrouter/free
LLM_ENABLED=true
LLM_STUB=0
