{
  "openapi": "3.0.3",
  "info": {
    "title": "Secure Auth API",
    "version": "1.0",
    "description": "Supabase-backed authentication API. Sign up, log in, and log out, with protected routes that require a Bearer JWT issued by Supabase Auth (the Identity Provider)."
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "tags": [
    {
      "name": "auth",
      "description": "Open and protected authentication routes"
    },
    {
      "name": "public",
      "description": "Open routes — no token required"
    },
    {
      "name": "protected",
      "description": "Guarded routes — require Authorization: Bearer <token>"
    }
  ],
  "paths": {
    "/auth/signup": {
      "post": {
        "tags": ["auth"],
        "summary": "Create a new user account",
        "operationId": "signUp",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "description": "Missing email or password, or Supabase rejected the signup",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Email and password are required"
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["auth"],
        "summary": "Authenticate user and return JWTs",
        "operationId": "logIn",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Logged in — access token and refresh token issued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "400": {
            "description": "Missing email or password",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid login credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Invalid login credentials"
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": ["auth"],
        "summary": "Terminate the user session",
        "operationId": "logOut",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Logged out — session revoked"
          },
          "400": {
            "description": "Supabase failed to revoke the session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, or expired token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "missing": {
                    "value": {
                      "error": "Access token required"
                    }
                  },
                  "invalid": {
                    "value": {
                      "error": "Invalid or expired token"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/protected/profile": {
      "get": {
        "tags": ["protected"],
        "summary": "Read private user profile data",
        "operationId": "getProfile",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Profile of the authenticated user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, or expired token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/protected/dashboard": {
      "get": {
        "tags": ["protected"],
        "summary": "Read a protected demo dashboard",
        "operationId": "getDashboard",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Protected data for the authenticated user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Dashboard"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, or expired token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/public/info": {
      "get": {
        "tags": ["public"],
        "summary": "Read public, unprotected data",
        "operationId": "getPublicInfo",
        "responses": {
          "200": {
            "description": "Public message — no auth required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicInfo"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Paste the access_token returned by POST /auth/login. Sent as: Authorization: Bearer <token>"
      }
    },
    "schemas": {
      "Credentials": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": {
            "type": "string",
            "example": "alice.dev@gmail.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "password123"
          }
        }
      },
      "User": {
        "type": "object",
        "required": ["id", "email", "created_at"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "dcc275cc-7f6e-47e1-b3b6-bde7f87e762a"
          },
          "email": {
            "type": "string",
            "example": "alice.dev@gmail.com"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Session": {
        "type": "object",
        "required": ["access_token", "refresh_token", "user"],
        "properties": {
          "access_token": {
            "type": "string",
            "description": "JWT to send as Authorization: Bearer <access_token>",
            "example": "eyJhbGciOiJFUzI1NiIsImtpZCI6..."
          },
          "refresh_token": {
            "type": "string",
            "description": "Long-lived token to mint new access tokens without re-login"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        }
      },
      "Profile": {
        "type": "object",
        "required": ["id", "email", "created_at"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Dashboard": {
        "type": "object",
        "required": ["message", "protected_data"],
        "properties": {
          "message": {
            "type": "string",
            "example": "Welcome back, alice.dev@gmail.com!"
          },
          "protected_data": {
            "type": "string",
            "example": "Only authenticated users can see this."
          }
        }
      },
      "PublicInfo": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "message": {
            "type": "string",
            "example": "Welcome stranger! This info is public."
          }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      }
    }
  }
}
